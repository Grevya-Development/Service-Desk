# Same Supabase project as People Success
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose

# Only needed locally for `npm run db:migrate` / `npm run db:seed` (Postgres connection string)
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Link back to People Success in the user menu
NEXT_PUBLIC_PEOPLE_SUCCESS_URL=https://peoplesuccess.vercel.app

# Protects /api/cron/sla (Vercel Cron sends it as a Bearer token)
CRON_SECRET=generate-a-long-random-string

# Show demo login buttons on the sign-in page (never in real production)
# NEXT_PUBLIC_SHOW_DEMO=true
