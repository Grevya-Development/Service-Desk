# Same Supabase project as People Success
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server only, never expose

# Only needed locally for `npm run db:migrate` / `npm run db:seed` (Postgres connection string)
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Link back to People Success in the user menu
PEOPLE_SUCCESS_URL=https://peoplesuccess.vercel.app

# Protects /api/cron/sla (Vercel Cron sends it as a Bearer token)
CRON_SECRET=generate-a-long-random-string

# Email notifications via Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxx
# Sender on a domain verified in Resend (until then Resend's test sender only reaches your own Resend account email)
EMAIL_FROM="Grevya Service Desk <desk@grevya.com>"
# EMAIL_REPLY_TO=it-support@grevya.com
# Outside production, only these recipients get mail (comma-separated; *@domain allowed). Empty = nobody.
# EMAIL_DEV_ALLOWLIST=you@grevya.com

# Show demo login buttons on the sign-in page (never in real production)
# SHOW_DEMO_LOGINS=true
